# ========================================================
# KrishiMitra Environment Variables Configuration
# Copy this file to .env.local to configure local integrations
# ========================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="KrishiMitra"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# Supabase Backend & Database (Planned for Phase 2)
# Create a project at https://supabase.com
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --------------------------------------------------------
# AI Integration: Google Gemini (Planned for Phase 2)
# Obtain an API key from Google AI Studio (https://aistudio.google.com)
# --------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# --------------------------------------------------------
# Weather Integration: IMD / OpenWeather (Planned for Phase 3)
# --------------------------------------------------------
WEATHER_API_KEY="your-weather-api-key"

# --------------------------------------------------------
# Agricultural Market Data: AGMARKNET / data.gov.in (Planned for Phase 4)
# --------------------------------------------------------
DATA_GOV_IN_API_KEY="your-data-gov-in-api-key"
