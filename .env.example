# ========================================================
# KrishiMitra — Environment Variables Configuration
# Copy this file to .env.local to configure your environment:
#   cp .env.example .env.local
# ========================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="KrishiMitra"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# Supabase Backend & Database (Phase 2)
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" into NEXT_PUBLIC_SUPABASE_URL
# 4. Copy "anon public" API key into NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Copy "service_role" secret key into SUPABASE_SERVICE_ROLE_KEY (Server-only!)
# 6. Run SQL migration from supabase/migrations/20261018000001_phase2_schema.sql
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --------------------------------------------------------
# Future Phase Integrations (Phase 3 & Phase 4)
# --------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
WEATHER_API_KEY="your-weather-api-key"
DATA_GOV_IN_API_KEY="your-data-gov-in-api-key"
